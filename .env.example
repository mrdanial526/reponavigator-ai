# ── RepoNavigator AI — Environment Variables Template ──────────────────────────
# Copy this file to `.env.local` and add your own keys.
# DO NOT commit `.env.local` or any private API keys to GitHub!

# Google Gemini API Key (optional but recommended for AI code chat)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GitHub Personal Access Token (optional - raises GitHub API rate limits for tree imports)
# Get a token at: https://github.com/settings/tokens (scope: public_repo)
GITHUB_TOKEN=
